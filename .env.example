# Copy to .env; never commit real values. Compose reads root .env only with --env-file.
# Python simulator reads process environment, not .env automatically.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=xiaoxi_dev
MQTT_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
MQTT_NODE_ID=node90
# Used by hermes upstream only; not auto-loaded by this repository.
HASS_URL=http://127.0.0.1:8123
HASS_TOKEN=
# Upstream Hermes model-provider credentials belong in its private configuration.
# Do not put actual dorm addresses, usernames, or tokens in tracked files.
