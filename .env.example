# Copy to .env; never commit real values. Compose reads root .env only with --env-file.
# Python simulator reads process environment, not .env automatically.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=xiaoxi_dev
MQTT_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
MQTT_NODE_ID=node90
# Host-side Home Assistant address, for tools running on this machine. The hermes
# container uses the compose service name instead and ignores this value.
HASS_URL=http://127.0.0.1:8123
# Long-Lived Access Token created in HA; see docs/deployment.md. Not auto-loaded.
HASS_TOKEN=
# Hermes dashboard login. Required, not optional: compose publishes 9119 on
# 0.0.0.0, and the upstream refuses to start a non-loopback dashboard with no
# registered auth provider. Rotate both on a shared network.
HERMES_DASHBOARD_USER=root
HERMES_DASHBOARD_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
# Upstream Hermes model-provider credentials belong in its private configuration.
# Do not put actual dorm addresses, usernames, or tokens in tracked files.
