# Copy to ignored deploy/runtime/secure.env; never overwrite the current root .env.
# This separate project name protects the existing deploy_* volumes by default.
COMPOSE_PROJECT_NAME=xiaoxi-review
MQTT_BIND_ADDRESS=127.0.0.1
DASHBOARD_BIND_ADDRESS=127.0.0.1
HERMES_DASHBOARD_USER=operator
HERMES_DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
# Gateway query credential ONLY. Backend HA token belongs only in gateway config.json.
HASS_TOKEN=REPLACE_WITH_RANDOM_DISTINCT_QUERY_TOKEN_32_CHARS
