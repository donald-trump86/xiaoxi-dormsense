{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XiaoXi DormSense telemetry v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "boot_id", "timestamp", "sequence", "simulated", "temperature", "humidity", "light"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "node_id": {"type": "string", "pattern": "^node[0-9]{2,3}$"},
    "boot_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "timestamp": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date-time", "pattern": "Z$"}]},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "simulated": {"type": "boolean"},
    "temperature": {"type": ["number", "null"]},
    "humidity": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "light": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "rssi": {"type": "integer", "minimum": -127, "maximum": 0},
    "uptime": {"type": "integer", "minimum": 0},
    "sensor_status": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "temperature": {"enum": ["ok", "missing", "error"]},
        "humidity": {"enum": ["ok", "missing", "error"]},
        "light": {"enum": ["ok", "missing", "error"]}
      }
    }
  }
}
