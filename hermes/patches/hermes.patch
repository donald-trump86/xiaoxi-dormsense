+function prepareXiaoxiSpokenText(rawText: string): string {
+  let text = rawText
+    .replace(/```[\s\S]*?```/g, ' ')
+    .replace(/!\[([^\]]*)\]\((?:[^()]|\([^)]*\))*\)/g, ' $1 ')
+    .replace(/\[([^\]]+)\]\((?:[^()]|\([^)]*\))*\)/g, '$1')
+    .replace(/https?:\/\/\S+/g, '')
+    .replace(/^\s*(?:[-*+]|\d+[.)])\s+/gm, '')
+    .replace(/~~(.+?)~~/gs, '$1')
+    .replace(/[*#_`>]+/g, ' ')
+    .replace(/\u2212/g, '-')
+  if (/[\u3400-\u9fff]/.test(text)) {
+    const number = String.raw`([-+]?(?:\d+(?:\.\d+)?|\.\d+))`
+    const start = String.raw`(?<![\d.])`
+    const units: [string, string, boolean][] = [
+      [String.raw`[%％]`, '百分之', true],
+      [String.raw`(?:℃|°\s*C)(?![A-Za-z])`, '摄氏度', false],
+      [String.raw`(?:℉|°\s*F)(?![A-Za-z])`, '华氏度', false],
+    ]
+    for (const [unit, word, prefix] of units) {
+      const measurement = (value: string) => {
+        const signed = value.replace(/-/g, '负').replace(/\+/g, '正')
+        return prefix ? word + signed : signed + word
+      }
+      const range = new RegExp(start + number + String.raw`\s*(?:` + unit + String.raw`)?\s*(?:[-–—~～]|to|至|到)\s*` + number + String.raw`\s*` + unit, 'gi')
+      text = text.replace(range, (_match, low: string, high: string) => measurement(low) + '至' + measurement(high))
+      text = text.replace(new RegExp(start + number + String.raw`\s*` + unit, 'gi'), (_match, value: string) => measurement(value))
+    }
+    for (const [unit, word] of [[String.raw`km\s*/\s*h`, '公里每小时'], ['mm', '毫米'], ['cm', '厘米'], ['m', '米']]) {
+      text = text.replace(new RegExp(String.raw`(?<=\d)\s*` + unit + String.raw`(?![A-Za-z0-9_/^²³])`, 'gi'), word)
+    }
+  }
+  return text.replace(/~/g, ' ').replace(/\s+/g, ' ').trim()
+}
